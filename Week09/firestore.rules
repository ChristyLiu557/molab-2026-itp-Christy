rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/reminders/{reminderId} {
      function owner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validReminder() {
        return request.resource.data.keys().hasOnly(['title', 'isCompleted'])
          && request.resource.data.keys().hasAll(['title', 'isCompleted'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.isCompleted is bool;
      }
      allow read, delete: if owner();
      allow create, update: if owner() && validReminder();
    }
  }
}

